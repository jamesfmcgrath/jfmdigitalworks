---
interface ProjectLink {
  label: string;
  url: string;
}

interface Project {
  name: string;
  challenge: string;
  myRole: string;
  resultsNote?: string;
  results: string[];
  tech: string[];
  award?: string;
  url?: string;
  links?: ProjectLink[];
}

const projects: Project[] = [
  {
    name: 'Tipperary County Council',
    challenge:
      'Bilingual English and Irish LocalGov Drupal site of about 7,500 pages needed an accessibility remediation programme.',
    myRole:
      'Delivered through The Confident in 2026. Prioritised template-level fixes; built a custom module that redirects untranslated Irish-language pages to English and shows the language switcher only when a translation exists; fixed colour contrast on banners and road alerts; moved CSS out of Asset Injector into the theme; generated accessible names for map markers from popup, tooltip or title data.',
    resultsNote:
      'Pages affected, Acquia Web Governance scans, Feb to Mar 2026. Further work is in progress.',
    // TODO(James): add NDA score before/after when the new report arrives.
    results: [
      'Links missing an accessible name: 3,000 to 12',
      'Map marker buttons missing an accessible name: 1,652 to 37',
      'Images missing alt text: 1,705 to 73',
      'Links inside text hard to identify: 7,375 to 1,238',
      'Empty breadcrumb links removed',
    ],
    tech: ['LocalGov Drupal', 'Accessibility', 'Bilingual', 'Custom module'],
    url: 'https://www.tipperarycoco.ie/',
  },
  {
    name: 'LocalGov Bus Data',
    challenge:
      'Cumberland Council wanted to publish UK bus timetables on its LocalGov Drupal site from open data feeds.',
    myRole:
      'Built the module and co-maintain it, delivered through The Confident in 2026. Funded by Cumberland Council as part of the LocalGov Drupal initiative.',
    results: [
      'Open-source module for Drupal 10 and 11',
      'Imports timetables from GTFS feeds and enriches stops from NaPTAN',
      'Exposes timetables as Drupal entities and Views',
      'Stable release covered by the Drupal Security Team',
      'Live on the Cumberland Council website',
    ],
    tech: ['LocalGov Drupal', 'Open source', 'GTFS', 'NaPTAN'],
    links: [
      {
        label: 'View project on drupal.org',
        url: 'https://www.drupal.org/project/localgov_bus_data',
      },
      {
        label: 'View live site',
        url: 'https://www.cumberland.gov.uk/parking-roads-and-transport/bus-services/buses',
      },
    ],
  },
  {
    name: 'Lexington-Fayette Urban County Government',
    challenge:
      'City of 300k+ residents needed multilingual site with significantly improved search functionality',
    myRole:
      'Led front-end implementation, accessibility testing, design-system integration and site search as part of the Interpersonal Frequency team',
    results: [
      'NAGW 2025 Pinnacle Members\' Choice (team award)',
      '2025 dotCOMM Gold (team award)',
      '2025 Government Experience Award (team award)',
      '140% increase in search result click-through',
      'Multi-language support delivered',
    ],
    tech: ['Modern Web', 'Accessibility', 'Multi-language', 'Government'],
    award: 'Team award',
    url: 'https://www.lexingtonky.gov/',
  },
  {
    name: 'Johnson County, Kansas',
    challenge:
      'County website needed complete redesign focused on resident usability and streamlined content access',
    myRole:
      'Rebuilt front-end architecture with performance work and conducted extensive cross-browser testing as part of the Interpersonal Frequency team',
    // TODO(James): restore "Positive community feedback" only with a source.
    results: [
      'NAGW Pinnacle 2022 Best of Show (team award)',
      'NAGW Pinnacle 2023 Best in Show (team award)',
      'Enhanced mobile experience for 500k+ residents',
      'Streamlined access to county services',
    ],
    tech: ['Performance', 'UX', 'Government'],
    award: 'Team award',
    url: 'https://www.jocogov.org/',
  },
  {
    name: 'Metropolitan Water Reclamation District of Greater Chicago',
    challenge:
      'Large municipal organisation needed accessible website with advanced document management and public education features',
    myRole:
      'Built responsive front-end templates and accessibility enhancements as part of the Interpersonal Frequency team',
    results: [
      'NAGW 2024 Pinnacle and Members\' Choice awards (team awards)',
      'Improved public access to environmental data',
      'Enhanced storytelling features for community',
    ],
    tech: ['Accessibility', 'Government', 'Document Management'],
    award: 'Team award',
    url: 'https://mwrd.org/',
  },
  {
    name: 'D.C. Public Library',
    challenge:
      'Library system needed modern digital presence to improve patron access to resources and services',
    myRole:
      'Built front-end component library and conducted accessibility audit as part of the Interpersonal Frequency team',
    results: [
      'Enhanced navigation and content discovery',
      'Modern, accessible user interface delivered',
      'Reusable component system for future development',
    ],
    tech: ['Component Library', 'Accessibility', 'React'],
    url: 'https://www.dclibrary.org/',
  },
];

// Projects with a single URL get one "View live site" link.
const linksFor = (project: Project): ProjectLink[] =>
  project.links ??
  (project.url && project.url !== '#'
    ? [{ label: 'View live site', url: project.url }]
    : []);
---
<section
  id="portfolio"
  class="bg-white py-12 md:py-20"
  aria-labelledby="portfolio-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mx-auto max-w-3xl pb-12 text-center md:pb-16">
      <h2
        id="portfolio-heading"
        class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl"
      >
        Recent Work
      </h2>
      <p class="text-lg text-gray-600">
        Current work for Irish and UK councils, including Tipperary County
        Council and LocalGov Bus Data, is delivered through The Confident.
        Earlier projects were with Interpersonal Frequency, a US agency, where
        I was front-end lead on government and civic Drupal sites.
      </p>
    </div>

    <!-- Case studies grid -->
    <div class="grid gap-10 md:grid-cols-2">
      {projects.map((project, index) => (
        <article
          class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
          aria-labelledby={`project-${index}-title`}
        >
          <!-- Award badge if applicable -->
          {project.award && (
            <div class="mb-4 inline-flex items-center rounded-full bg-yellow-100 px-3 py-1 text-sm font-medium text-yellow-900">
              <svg
                class="mr-2 h-4 w-4"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              {project.award}
            </div>
          )}

          <!-- Project name -->
          <h3
            id={`project-${index}-title`}
            class="mb-3 text-xl font-semibold text-gray-900"
          >
            {project.name}
          </h3>

          <!-- Challenge -->
          <div class="mb-4">
            <p class="text-sm font-medium text-gray-700 mb-1">Challenge:</p>
            <p class="text-gray-600">{project.challenge}</p>
          </div>

          <!-- My Role -->
          <div class="mb-4">
            <p class="text-sm font-medium text-gray-700 mb-1">My Role:</p>
            <p class="text-gray-600">{project.myRole}</p>
          </div>

          <!-- Results -->
          <div class="mb-4">
            <p class="text-sm font-medium text-gray-700 mb-2">Results:</p>
            {project.resultsNote && (
              <p class="mb-2 text-sm text-gray-600">{project.resultsNote}</p>
            )}
            <ul class="space-y-1 text-gray-600">
              {project.results.map((result) => (
                <li class="flex items-start">
                  <svg
                    class="mr-2 mt-0.5 h-5 w-5 flex-shrink-0 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    ></path>
                  </svg>
                  {result}
                </li>
              ))}
            </ul>
          </div>

          <!-- Tech tags -->
          <div class="mb-4 flex flex-wrap gap-2">
            {project.tech.map((tag) => (
              <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">
                {tag}
              </span>
            ))}
          </div>

          <!-- Project links (external, open in a new tab) -->
          {linksFor(project).length > 0 && (
            <div class="flex flex-wrap gap-x-6 gap-y-2">
              {linksFor(project).map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"
                >
                  {link.label}
                  <span class="sr-only"> for {project.name} (opens in new tab)</span>
                  <svg
                    class="ml-1 h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
