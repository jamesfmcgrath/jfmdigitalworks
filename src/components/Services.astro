---
const services = [
  {
    iconPath: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
    name: 'Accessibility audits and remediation',
    for: 'Councils and public bodies working to WCAG 2.2 AA, and organisations preparing for the European Accessibility Act',
    deliverables: [
      'Audit to WCAG 2.2 AA and EN 301 549, combining manual testing with assistive technology and automated scans',
      'Prioritised remediation report',
      'Code fixes, starting with templates and shared components',
      'Guidance for content editors',
      'Help preparing for NDA monitoring and your accessibility statement',
    ],
    whyNow: 'Public bodies are monitored under the EU Web Accessibility Directive, transposed in Ireland as S.I. 358/2020. The European Accessibility Act has applied to many private-sector services since 28 June 2025.',
    timeline: 'Audits completed in 1 to 2 weeks, remediation timeline varies by scope',
  },
  {
    iconPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    name: 'LocalGov Drupal development',
    for: 'Councils running LocalGov Drupal, and the agencies that support them',
    deliverables: [
      'New features for LocalGov Drupal sites',
      'Custom and contributed modules, such as LocalGov Bus Data',
      'Theme work and front-end components',
      'Integrations with open data feeds and third-party services',
    ],
    whyNow: 'Features built as LocalGov Drupal modules can be reused by other councils, so work funded by one council can benefit many.',
    timeline: 'Scoped and agreed per feature at proposal stage',
  },
  {
    iconPath: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    name: 'Drupal upgrades and modernisation',
    for: 'Organisations on Drupal 7, or on older Drupal 9 or 10 sites',
    deliverables: [
      'Upgrade or migration to Drupal 11',
      'Content migration, with test migrations and content checks before launch',
      'Theming with Single Directory Components (SDC)',
      'Team training and documentation',
      '30-day post-migration support',
    ],
    whyNow: 'Older Drupal versions lose community security support. Planning the upgrade early avoids a rushed migration.',
    timeline: '6 to 12 weeks depending on complexity',
  },
  {
    iconPath: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    name: 'Ongoing support partner',
    for: 'Organisations needing reliable technical capacity without full-time hire overhead',
    deliverables: [
      'Monthly retainer for predictable capacity',
      'Feature development, maintenance, monitoring',
      'Priority response time',
      'Regular check-ins and roadmap planning',
      'No long-term contract required',
    ],
    whyNow: 'Flexibility without recruiting costs. Continuity without employment overhead.',
    timeline: 'Month-to-month engagement, typically 20 to 40 hours/month',
  },
];
---
<section
  id="services"
  class="bg-gray-50 py-12 md:py-20"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mx-auto max-w-3xl pb-12 text-center md:pb-16">
      <h2 id="services-heading" class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
        How I Can Help
      </h2>
      <p class="text-lg text-gray-600">
        Choose the service that matches your current challenge.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid gap-8 sm:grid-cols-2">
      {services.map((service) => (
        <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <!-- Icon -->
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100" aria-hidden="true">
            <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.iconPath}></path>
            </svg>
          </div>

          <!-- Service name -->
          <h3 class="mb-3 text-xl font-semibold text-gray-900">
            {service.name}
          </h3>

          <!-- For -->
          <div class="mb-4">
            <p class="text-sm font-medium text-gray-700 mb-1">For:</p>
            <p class="text-gray-600">{service.for}</p>
          </div>

          <!-- What you get -->
          <div class="mb-4 flex-grow">
            <p class="text-sm font-medium text-gray-700 mb-2">
              What you get:
            </p>
            <ul class="space-y-1 text-gray-600">
              {service.deliverables.map((deliverable) => (
                <li class="flex items-start">
                  <svg
                    class="mr-2 mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    ></path>
                  </svg>
                  {deliverable}
                </li>
              ))}
            </ul>
          </div>

          <!-- Why now -->
          <div class="mb-4">
            <p class="text-sm font-medium text-gray-700 mb-1">Why now:</p>
            <p class="text-gray-600 italic">{service.whyNow}</p>
          </div>

          <!-- Timeline -->
          <div class="mb-6">
            <p class="text-sm font-medium text-gray-700 mb-1">Timeline:</p>
            <p class="text-gray-600">{service.timeline}</p>
          </div>

          <!-- CTA -->
          <a
            href="#contact"
            class="mt-auto inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500 min-h-[44px] transition-colors"
          >
            Discuss This Project
            <svg
              class="ml-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              ></path>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
